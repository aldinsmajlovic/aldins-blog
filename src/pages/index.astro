---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const recentPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Aldin Smajlovic <span class="pronouns">(He/Him)</span></h1>
				<p class="tagline">IT Security Consultant @ Wisest AB</p>
				<p class="bio">
		Security Specialist at Wisest AB. Developing internal security tools and working with offensive infrastructure testing.
				</p>
			</section>

			<section class="toolkit-section">
				<h2>Toolkit</h2>
				<div class="toolkit-grid">
					<div class="toolkit-column">
						<h3>Systems & Shells</h3>
						<ul>
							<li>Arch Linux</li>
							<li>Kali Linux</li>
							<li>Hyprland</li>
							<li>Zsh (Kitty)</li>
							<li>Proxmox</li>
							<li>Docker</li>
						</ul>
					</div>
					<div class="toolkit-column">
						<h3>Languages & Core</h3>
						<ul>
							<li>Python</li>
							<li>Go</li>
							<li>Git</li>
						</ul>
					</div>
					<div class="toolkit-column">
						<h3>Offensive & Web</h3>
						<ul>
							<li>Burp Suite Professional</li>
							<li>Nmap</li>
							<li>Nuclei</li>
							<li>FFuf</li>
							<li>Feroxbuster</li>
							<li>SQLmap</li>
							<li>NetExec</li>
							<li>Impacket</li>
							<li>Hashcat</li>
						</ul>
					</div>
				</div>
			</section>
			<hr />
				<div class="section-header">
					<h2>Latest Research</h2>
					<a href="/blog" class="view-all">View Archive →</a>
				</div>
				<ul class="post-list">
					{recentPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="title">{post.data.title}</span>
								<span class="date"><FormattedDate date={post.data.pubDate} /></span>
							</a>
						</li>
					))}
				</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero { padding: 3rem 0; }
	.hero h1 { font-size: 3rem; margin: 0; color: var(--text-bold); display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap; }
	.pronouns { font-size: 1.2rem; color: var(--text-muted); font-weight: normal; }
	.tagline { font-size: 1.2rem; color: var(--accent); font-weight: 600; margin-top: 0.5rem; }
	.bio { max-width: 650px; color: var(--text-main); margin-top: 1.5rem; line-height: 1.6; }

	.toolkit-section { padding: 1rem 0 3rem 0; }
	.toolkit-section h2 { font-size: 1.8rem; margin-bottom: 1.5rem; color: var(--text-bold); }
	.toolkit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
	.toolkit-column h3 { font-size: 1.1rem; color: var(--accent); font-family: ui-monospace, monospace; margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0.5rem; }
	.toolkit-column ul { list-style: none; padding: 0; margin: 0; }
	.toolkit-column li { color: var(--text-main); font-size: 0.95rem; margin-bottom: 0.4rem; font-family: ui-monospace, monospace; }
	@media (max-width: 720px) {
		.toolkit-grid { grid-template-columns: 1fr; gap: 1.5rem; }
	}

	.section { padding: 2rem 0; }
	.section-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem; }
	.view-all { font-size: 0.9rem; color: var(--accent); text-decoration: none; }

	.post-list { list-style: none; padding: 0; }
	.post-list li a { 
		display: flex; justify-content: space-between; padding: 1rem; 
		border: 1px solid var(--border); border-radius: 8px; margin-bottom: 0.75rem;
		text-decoration: none; transition: 0.2s ease;
	}
	.post-list li a:hover { border-color: var(--accent); background: var(--bg-surface); transform: translateY(-2px); }
	.title { font-weight: 600; color: var(--text-bold); }
	.date { color: var(--text-muted); font-size: 0.9rem; }
</style>