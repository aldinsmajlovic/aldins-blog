---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { readingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			minutes: readingTime(post.body),
			// Sorted newest-first: i-1 is newer, i+1 is older.
			nextPost: posts[i - 1] ? { slug: posts[i - 1].id, title: posts[i - 1].data.title } : undefined,
			prevPost: posts[i + 1] ? { slug: posts[i + 1].id, title: posts[i + 1].data.title } : undefined,
		},
	}));
}

const { post, minutes, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} minutes={minutes} prevPost={prevPost} nextPost={nextPost}>
	<Content />
</BlogPost>
